---
import Clickable from "@/components/Clickable.astro";
import PostsListPlain from "@/components/PostsListPlain.astro";
import CardLayout from "@/layouts/CardLayout.astro";
import { categoryUrl } from "@/utils/url";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");

const categories = [
  ...new Set(posts.map((x) => x.data.categories).filter(Boolean)),
];
const postsInCategory = (category: string) =>
  posts
    .filter((post) => post.data.categories === category)
    .sort((a, b) => (a.data.date > b.data.date ? -1 : 1));
---

<CardLayout title="Categories" description="All categories used in the blog">
  <div class="categories-list">
    {
      categories.map((category) => (
        <Clickable
          is="div"
          href={categoryUrl(category!)}
          class="category-item pt-4 px-2"
        >
          <div class="inline-flex items-center gap-2 justify-between w-full">
            <h1 class="text-lg font-bold inline-flex items-center gap-1">
              <div class="i-mingcute-folder-2-line flex-shrink-0" />
              {category}
            </h1>
            <span class="flex-shrink-0 badge text-xs badge-primary font-sans">
              x {postsInCategory(category!).length}
            </span>
          </div>
          <PostsListPlain
            class="px-2 text-sm"
            posts={postsInCategory(category!).slice(0, 5)}
          />
        </Clickable>
      ))
    }
  </div>
</CardLayout>
